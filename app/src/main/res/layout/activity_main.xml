<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF5F1"
    android:clipToPadding="false"
    android:overScrollMode="ifContentScrolls">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingEnd="18dp"
    android:paddingTop="18dp"
    android:paddingBottom="28dp">

    <!-- 顶部标题栏 + 悬浮状态胶囊 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="#3E3440"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="桌面上的软萌陪伴小猫"
                android:textColor="#887C8B"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/status_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="○ 未开启"
            android:textColor="#887C8B"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 互动舞台卡片 -->
    <LinearLayout
        android:id="@+id/stage_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="vertical"
        android:paddingTop="10dp"
        android:paddingBottom="14dp">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true"
            android:scrollbars="none">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="244dp">

                <com.yuyu.bongocat.RiveView
                    android:id="@+id/preview_cat"
                    android:layout_width="180dp"
                    android:layout_height="180dp"
                    android:layout_gravity="center" />
            </FrameLayout>
        </HorizontalScrollView>

        <TextView
            android:id="@+id/stage_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="点点小猫的头、鼻子、爪子或尾巴试试"
            android:textColor="#9A8999"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 主控操作条：显示 / 收起悬浮猫 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_show"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1.35"
            android:layout_marginEnd="8dp"
            android:text="显示悬浮猫"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_hide"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="收起悬浮猫"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 三宫格快捷功能区 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_actions"
            android:layout_width="0dp"
            android:layout_height="76dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:padding="8dp"
            android:text="动作剧场\n9 种表演"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btn_tools"
            android:layout_width="0dp"
            android:layout_height="76dp"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:padding="8dp"
            android:text="猫咪工具箱\n番茄·便签"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btn_weather"
            android:layout_width="0dp"
            android:layout_height="76dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:padding="8dp"
            android:text="天气窗台\n选择城市"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- 外观装扮卡片 -->
    <LinearLayout
        android:id="@+id/card_appearance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="外观装扮"
            android:textColor="#3E3440"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="配饰"
            android:textColor="#887C8B"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/costume_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:background="#F3EAE5" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="毛色"
            android:textColor="#887C8B"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/color_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />
    </LinearLayout>

    <!-- 悬浮显示与交互卡片 -->
    <LinearLayout
        android:id="@+id/card_display"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="悬浮窗设置"
            android:textColor="#3E3440"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/label_size"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="大小：180dp"
            android:textColor="#3E3440"
            android:textSize="14sp"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/seek_size"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:max="180"
            android:progress="60" />

        <TextView
            android:id="@+id/label_opacity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="透明度：100%"
            android:textColor="#3E3440"
            android:textSize="14sp"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/seek_opacity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:max="90"
            android:progress="90" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:background="#F3EAE5" />

        <Switch
            android:id="@+id/touch_through"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="触摸穿透"
            android:textColor="#3E3440"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="开启后点击可穿透悬浮猫，直接操作下方应用"
            android:textColor="#887C8B"
            android:textSize="12sp" />
    </LinearLayout>

</LinearLayout>
</ScrollView>
